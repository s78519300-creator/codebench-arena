{
  "id": "merge_intervals",
  "title": "Merge overlapping intervals",
  "function": "merge_intervals",
  "prompt": "Return a new sorted list of merged [start, end] intervals. Touching intervals merge. Do not mutate the input. No third-party packages.",
  "max_complexity": 8,
  "forbidden_imports": [
    "numpy",
    "pandas"
  ],
  "core": [
    {
      "name": "overlap",
      "args": [
        [
          [
            1,
            3
          ],
          [
            2,
            6
          ],
          [
            8,
            10
          ]
        ]
      ],
      "expect": [
        [
          1,
          6
        ],
        [
          8,
          10
        ]
      ]
    },
    {
      "name": "unsorted",
      "args": [
        [
          [
            8,
            10
          ],
          [
            1,
            3
          ],
          [
            2,
            6
          ]
        ]
      ],
      "expect": [
        [
          1,
          6
        ],
        [
          8,
          10
        ]
      ]
    },
    {
      "name": "disjoint",
      "args": [
        [
          [
            1,
            2
          ],
          [
            5,
            6
          ]
        ]
      ],
      "expect": [
        [
          1,
          2
        ],
        [
          5,
          6
        ]
      ]
    }
  ],
  "edge": [
    {
      "name": "empty",
      "args": [
        []
      ],
      "expect": []
    },
    {
      "name": "touching",
      "args": [
        [
          [
            1,
            2
          ],
          [
            2,
            3
          ]
        ]
      ],
      "expect": [
        [
          1,
          3
        ]
      ]
    },
    {
      "name": "nested",
      "args": [
        [
          [
            1,
            10
          ],
          [
            2,
            3
          ]
        ]
      ],
      "expect": [
        [
          1,
          10
        ]
      ]
    },
    {
      "name": "input_not_mutated",
      "args": [
        [
          [
            3,
            4
          ],
          [
            1,
            2
          ]
        ]
      ],
      "expect": [
        [
          1,
          2
        ],
        [
          3,
          4
        ]
      ],
      "no_mutation": true
    }
  ]
}